# Backend Environment Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0
CORS_ORIGIN=http://localhost:5173

# Authentication & JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# Initial Administrator Provisioning (Used by npm run setup:admin)
ADMIN_NAME=UTSAV Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourSecureAdminPasswordHere

# SMTP Email Configuration (Optional for Password Recovery)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@utsav.in
FROM_NAME=UTSAV Events
