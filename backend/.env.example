# Backend Environment Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0
CORS_ORIGIN=http://localhost:5173

# Authentication & JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=8h
COOKIE_EXPIRE=7

# Session Management Policy Configuration (All units in milliseconds)
# Inactivity timeout (default: 30 minutes = 1,800,000 ms). Active authenticated requests extend this deadline.
SESSION_INACTIVITY_TIMEOUT_MS=1800000
# Absolute maximum session lifetime (default: 8 hours = 28,800,000 ms). Hard ceiling that can NEVER be extended.
SESSION_ABSOLUTE_LIFETIME_MS=28800000
# Frontend timeout warning modal trigger before inactivity expiry (default: 2 minutes = 120,000 ms).
SESSION_WARNING_BEFORE_EXPIRY_MS=120000

# Initial Administrator Provisioning (Used by npm run setup:admin)
ADMIN_NAME=UTSAV Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourSecureAdminPasswordHere

# Two-Factor Authentication (2FA) Configuration
# 32-byte secret key used for AES-256-GCM encryption of authenticator TOTP secrets at rest
TOTP_ENCRYPTION_KEY=your_32_byte_hex_or_passphrase_encryption_key_here
# Enforce mandatory Google Authenticator TOTP for all administrator accounts
REQUIRE_ADMIN_2FA=true

# SMTP Email Configuration (Used for Attendee/Organizer Email OTP and Notifications)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@utsav.in
FROM_NAME=UTSAV Events
